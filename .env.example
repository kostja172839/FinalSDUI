# Optional ERP table connections for localhost development.
# Copy to .env.local, set the HTTPS base path of the table API and restart pnpm dev.
ERP_TABLE_CONNECTIONS='[{"id":"qa","baseUrl":"https://erp-qa.example.test/api/tables","cookieEnv":"ERP_TABLE_COOKIE_QA"}]'
# Supply the Cookie request-header value for your own authorized development session.
# Use name=value pairs only. Set this in .env.local or the dev server environment.
ERP_TABLE_COOKIE_QA=
